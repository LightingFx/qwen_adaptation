{
  "upstream_models": {
    "qwen1.5": "Qwen/Qwen1.5-7B-Chat",
    "qwen2": "Qwen/Qwen2-7B-Instruct",
    "qwen2.5": "Qwen/Qwen2.5-7B-Instruct",
    "qwen3": "Qwen/Qwen3-8B"
  },
  "va_sft": {
    "horizons_epochs": [
      2,
      6
    ],
    "seed_reference": 42,
    "repeated_endpoint_seeds": [
      17,
      42,
      123
    ],
    "max_length": 4096,
    "learning_rate": 2e-05,
    "warmup_ratio": 0.1,
    "lr_scheduler": "cosine",
    "dtype": "bfloat16",
    "effective_batch_size": 64,
    "lora_rank": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.0,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "trainable_vocabulary_rows": "added rows only",
    "six_epoch_batch": {
      "qwen1.5": {
        "gpus": 1,
        "per_device": 2,
        "accumulation": 32
      },
      "qwen2": {
        "gpus": 1,
        "per_device": 4,
        "accumulation": 16
      },
      "qwen2.5": {
        "gpus": 2,
        "per_device": 4,
        "accumulation": 8
      },
      "qwen3": {
        "gpus": 2,
        "per_device": 4,
        "accumulation": 8
      }
    }
  },
  "cpt_sft": {
    "cpt_lora_rank": 16,
    "cpt_vocabulary_updates": "full embedding and LM-head matrices",
    "sft_stage": "same settings and added-row update policy as two-epoch VA-SFT",
    "training_text": "not distributed"
  },
  "evaluation": {
    "thinking": false,
    "temperature": 0.0,
    "top_p": 1.0,
    "mt_prompt_style": "explicit-user",
    "ti_mmlu_shots": 2,
    "gsm_shots": 2,
    "mcq_max_tokens": 16,
    "gsm_max_tokens": 1024,
    "mt_max_tokens": 256,
    "spbleu_tokenizer": "flores200",
    "paper_chrf_word_order": 0
  }
}
